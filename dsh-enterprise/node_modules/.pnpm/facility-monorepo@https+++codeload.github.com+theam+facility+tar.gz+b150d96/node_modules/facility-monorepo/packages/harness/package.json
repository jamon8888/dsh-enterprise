{
  "name": "@facility/harness",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./chains": "./dist/chain.js",
    "./provenance": "./dist/provenance.js",
    "./session": "./dist/session.js",
    "./validate": "./dist/validate.js",
    "./wsjf": "./dist/wsjf.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/chain.ts src/provenance.ts src/session.ts src/validate.ts src/wsjf.ts --format esm --dts",
    "build:runtime": "tsup src/index.ts src/chain.ts src/provenance.ts src/session.ts src/validate.ts src/wsjf.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
